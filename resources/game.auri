// The script that `examples/scripting.rs` drives.
//
// `Player` owns its own data. The host never sees the fields, it only holds
// the value `Player::create` returns and calls the methods back on that value
// when the matching game state event happens.
//
// `print`, `text`, `draw_sprite` and `input_down` are host functions the
// example registers. They are how the script reaches the game.

mod player {
    struct Player {
        x,
        y,
        texture
    }

    // `text` turns a number into something `+` can join to a string. The
    // player is handed back with `move`, so the host gets the owner and the
    // object outlives this call.
    fn Player::create(texture) {
        let player = Player { x: 0.0f, y: 0.0f, texture: texture };
        print("Created player at " + text(player.x) + ", " + text(player.y));
        move player
    }

    fn Player::destroy(self) {
        print("Destroying player at " + text(self.x) + ", " + text(self.y));
    }

    fn Player::update(self, delta_time) {
        let velocity = speed() * delta_time;
        self.x += axis("left", "right") * velocity;
        self.y += axis("up", "down") * velocity;
    }

    fn Player::draw(self) {
        draw_sprite(self.texture, self.x, self.y);
    }
}

mod utils {
    fn speed() {
        150.0f
    }

    fn axis(negative, positive) {
        let result = 0.0f;
        if input_down(negative) {
            result -= 1.0f;
        }
        if input_down(positive) {
            result += 1.0f;
        }
        result
    }

    fn greet(name) {
        "Hello from " + name + "!"
    }
}
